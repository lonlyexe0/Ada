{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Applications/Ada.app/Contents/MacOS/Ada --claude-event start 2>/dev/null || true",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Applications/Ada.app/Contents/MacOS/Ada --claude-event tool 2>/dev/null || true",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Applications/Ada.app/Contents/MacOS/Ada --claude-event wait 2>/dev/null || true",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/Applications/Ada.app/Contents/MacOS/Ada --claude 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
